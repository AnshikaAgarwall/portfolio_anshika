# Copy to .env and fill in. Only VITE_* variables reach the browser, so never
# put secrets here.

# Base URL of the backend API (empty = use the built-in mock data).
VITE_API_URL=

# Public URL of the live site, no trailing slash. Used for canonical URLs,
# Open Graph URLs and to generate public/sitemap.xml during `npm run build`.
VITE_SITE_URL=https://your-domain.com

# Optional: fake latency (ms) for mock requests, to see loading skeletons in dev.
VITE_MOCK_DELAY=0
